# Moonpool updater sidecar — the only container with the Docker socket.
# See scripts/updater.mjs. Internal network only, bearer-token gated.
FROM node:22-alpine
RUN apk add --no-cache git docker-cli docker-cli-compose
WORKDIR /app
COPY scripts/updater.mjs ./updater.mjs
EXPOSE 9888
CMD ["node", "updater.mjs"]
