# ── Pool controller ──────────────────────────────────────────────
# URL of nodejs-poolController. In Docker Compose this is the service name.
# For LAN integration testing from a dev machine: http://<pi-ip>:4200
NJSPC_URL=http://njspc:4200

# Run entirely against a built-in simulated pool (no hardware, no njsPC).
# The simulator models pool+spa, 8 circuits, IntelliFlo, IntelliChlor,
# IntelliBrite and drifting temperatures.
MOCK_MODE=true

# ── Storage ──────────────────────────────────────────────────────
# SQLite database location. Everything (users, sessions, history, scenes,
# automations, chat threads, audit log) lives in this single local file.
DATABASE_PATH=./data/moonpool.db

# Secret used to sign session cookies. Generate once:
#   openssl rand -hex 32
AUTH_SECRET=change-me-generate-a-long-random-string
# Sliding session lifetime in days (default 90). Sessions renew on every use,
# so a device that opens the app even occasionally never gets logged out —
# only one untouched for this whole window expires.
#SESSION_DAYS=90

# ── Copilot (local LLM via Ollama) ───────────────────────────────
# OpenAI-compatible endpoint. Default assumes the ollama compose service.
COPILOT_BASE_URL=http://ollama:11434/v1
# Any Ollama tag works (pull it first). Can also be changed live in
# Settings → Voice & AI without a restart.
COPILOT_MODEL=qwen3:1.7b
# Only needed when pointing COPILOT_BASE_URL at a cloud provider instead.
COPILOT_API_KEY=

# Token budget for the whole request. Keep in step with the server's context
# window (OLLAMA_CONTEXT_LENGTH in docker-compose.yml): when a request
# overflows, llama.cpp drops tokens from the FRONT, which silently deletes the
# system prompt and leaves the copilot improvising. Moonpool trims old chat
# turns to stay under this rather than trusting the window to be generous.
COPILOT_CONTEXT_TOKENS=4096

# ── Low-memory hosts (Raspberry Pi, 2 GB) ────────────────────────────
# Measured resident size at a 4096-token window:
#   qwen3:0.6b  0.80 GB      qwen3:1.7b  1.66 GB
# A 2 GB Pi also runs Next.js (~250 MB) and njsPC, so 1.7b will not fit; use
# 0.6b there and keep OLLAMA_KV_CACHE_TYPE=q8_0. The copilot's grounding layer
# (src/server/copilot/grounding.ts) corrects body, circuit and timing mistakes
# deterministically from the user's own words, which is what makes a model
# this small safe to ship.
#COPILOT_MODEL=qwen3:0.6b
# How long to wait for the local model, in ms (default 60000 — cold Ollama
# loads and small thinking models need headroom).
#COPILOT_TIMEOUT_MS=60000
# Dev: set true to use the real LLM even in MOCK_MODE (default is a
# deterministic parser so the simulator needs no model at all).
COPILOT_FORCE_LLM=false

# ── WeatherFlow Tempest (optional) ───────────────────────────────
# Easiest setup: Settings → Tempest weather station in the app (live status,
# token entry, station picker) — values saved there override these.
# If a Tempest station is on your LAN, Moonpool listens for its UDP
# broadcasts on :50222 automatically — measured rain feeds the water-level
# estimator, real wind feeds heat advisories, lightning triggers alerts.
TEMPEST_UDP=true
# REST fallback for setups where LAN broadcasts can't reach the container:
# create a token at tempestwx.com → Settings → Data Authorizations.
TEMPEST_TOKEN=
TEMPEST_STATION_ID=

# ── Remote access: direct port-forward with automatic HTTPS ──────
# For the docker-compose "expose" profile: a domain or DDNS name pointing at
# your home IP. Forward ports 80+443 to the Pi, then
#   docker compose --profile expose up -d
# Caddy gets a Let's Encrypt certificate for this name automatically.
#MOONPOOL_DOMAIN=pool.example.com

# ── Misc ─────────────────────────────────────────────────────────
TZ=America/Denver
# Latitude/longitude for weather + sunrise/sunset automations (no API key
# needed). These stay authoritative until you save a location in Settings →
# Units & format — the in-app value then wins for those fields (the UI shows
# which source is active, with a "use .env again" reset).
POOL_LATITUDE=39.74
POOL_LONGITUDE=-104.99
