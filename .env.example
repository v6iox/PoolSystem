# ── Pool controller ──────────────────────────────────────────────
# URL of nodejs-poolController. In Docker Compose this is the service name.
# For LAN integration testing from a dev machine: http://<pi-ip>:4200
NJSPC_URL=http://njspc:4200

# Run entirely against a built-in simulated pool (no hardware, no njsPC).
# The simulator models pool+spa, 8 circuits, IntelliFlo, IntelliChlor,
# IntelliBrite and drifting temperatures.
MOCK_MODE=true

# ── Storage ──────────────────────────────────────────────────────
# SQLite database location. Everything (users, sessions, history, scenes,
# automations, chat threads, audit log) lives in this single local file.
DATABASE_PATH=./data/moonpool.db

# Secret used to sign session cookies. Generate once:
#   openssl rand -hex 32
AUTH_SECRET=change-me-generate-a-long-random-string

# ── Copilot (local LLM via Ollama) ───────────────────────────────
# OpenAI-compatible endpoint. Default assumes the ollama compose service.
COPILOT_BASE_URL=http://ollama:11434/v1
# Any Ollama tag works (pull it first). Can also be changed live in
# Settings → Voice & AI without a restart.
COPILOT_MODEL=qwen3:1.7b
# Only needed when pointing COPILOT_BASE_URL at a cloud provider instead.
COPILOT_API_KEY=
# Dev: set true to use the real LLM even in MOCK_MODE (default is a
# deterministic parser so the simulator needs no model at all).
COPILOT_FORCE_LLM=false

# ── WeatherFlow Tempest (optional) ───────────────────────────────
# If a Tempest station is on your LAN, Moonpool listens for its UDP
# broadcasts on :50222 automatically — measured rain feeds the water-level
# estimator, real wind feeds heat advisories, lightning triggers alerts.
TEMPEST_UDP=true
# REST fallback for setups where LAN broadcasts can't reach the container:
# create a token at tempestwx.com → Settings → Data Authorizations.
TEMPEST_TOKEN=
TEMPEST_STATION_ID=

# ── Misc ─────────────────────────────────────────────────────────
TZ=America/Denver
# Latitude/longitude for weather + sunrise/sunset automations (no API key needed).
POOL_LATITUDE=39.74
POOL_LONGITUDE=-104.99
